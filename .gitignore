# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# macOS
.DS_Store

# PseudoScope run artifacts (sources are restored; backups are local-only)
**/.pseudoscope/backups/
**/*.pseudoscope-sweep.partial

# Tool outputs (each tool writes under its own output/ so targets stay clean)
PseudoClang/output/
pstrace/output/

.venv/
benchmark/.venv/
benchmark/pseudoscope-results.json
benchmark/pseudoscope-sweep-*.json
benchmark/.*.pseudoscope-sweep.partial
benchmark/**/*.egg-info/
benchmark/build/
benchmark/dist/
